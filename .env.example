# Personal non-commercial TMDB developer key. Server-side only. Leave empty until you have one.
TMDB_API_KEY=

# Copy the real request limit from the TMDB dashboard. The default is 30 requests / 10 seconds.
# TMDB_RATE_LIMIT=30
# TMDB_RATE_WINDOW_MS=10000

# Postgres 16 from docker compose.
DATABASE_URL=postgres://trykt:trykt@localhost:5432/trykt

# Vitest uses a separate database.
TEST_DATABASE_URL=postgres://trykt:trykt@localhost:5432/trykt_test

# Session signing secret. Generate one locally. Do not commit it.
BETTER_AUTH_SECRET=

# Public origin of this app.
BETTER_AUTH_URL=http://localhost:3000

# Production mail. Development always prints verification and reset codes in the terminal.
# When both are set, production sends through Resend. No marketing mail.
# RESEND_API_KEY=
# MAIL_FROM=
